<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:xt="http://schemas.android.com/apk/res-auto">

	<!-- ============================ Startup app ============================ -->
	<PreferenceScreen
		android:key="screenStartup"
		android:title="@string/pref_startup_screen"
		android:summary="@string/pref_startup_screen_sum">

		<Preference
			android:key="migrationNoticeView"
			android:title="@string/pref_migration_notice"
			android:persistent="false" />

		<PreferenceCategory android:title="@string/pref_startup_category">

			<CheckBoxPreference
				android:key="startupEnabled"
				android:title="@string/pref_startup_enabled"
				android:summary="@string/pref_startup_enabled_sum"
				android:defaultValue="false" />

			<ListPreference
				android:key="startupTrigger"
				android:title="@string/pref_startup_trigger"
				android:summary="%s"
				android:entries="@array/startup_trigger_entries"
				android:entryValues="@array/startup_trigger_values"
				android:defaultValue="COLD_BOOT" />

			<ListPreference
				android:key="startupMode"
				android:title="@string/pref_startup_mode"
				android:summary="%s"
				android:entries="@array/startup_mode_entries"
				android:entryValues="@array/startup_mode_values"
				android:defaultValue="SINGLE" />

			<com.pijulius.xposedteyes.settings.AppPickerPreference
				android:key="startupPrimary"
				android:title="@string/pref_startup_primary" />

			<com.pijulius.xposedteyes.settings.AppPickerPreference
				android:key="startupSecondary"
				android:title="@string/pref_startup_secondary" />

			<com.pijulius.xposedteyes.settings.IntPickerPreference
				android:key="startupDelayMs"
				android:title="@string/pref_startup_delay"
				android:defaultValue="5000"
				xt:minValue="0"
				xt:maxValue="60"
				xt:scale="1000"
				xt:presets="0,3,5,10,15"
				xt:unitLabel="@string/unit_seconds" />

			<com.pijulius.xposedteyes.settings.IntPickerPreference
				android:key="startupRetryCount"
				android:title="@string/pref_startup_retry_count"
				android:defaultValue="1"
				xt:minValue="0"
				xt:maxValue="3"
				xt:scale="1"
				xt:presets="0,1,2,3"
				xt:unitLabel="@string/unit_times" />

			<com.pijulius.xposedteyes.settings.IntPickerPreference
				android:key="startupRetryDelayMs"
				android:title="@string/pref_startup_retry_delay"
				android:defaultValue="5000"
				xt:minValue="1"
				xt:maxValue="30"
				xt:scale="1000"
				xt:presets="1,3,5,10"
				xt:unitLabel="@string/unit_seconds" />

			<ListPreference
				android:key="startupForegroundPolicy"
				android:title="@string/pref_startup_foreground"
				android:summary="%s"
				android:entries="@array/startup_foreground_entries"
				android:entryValues="@array/startup_foreground_values"
				android:defaultValue="ALWAYS" />

			<Preference
				android:key="startupSafetyNote"
				android:title="@string/pref_startup_safety"
				android:summary="@string/pref_startup_safety_sum"
				android:selectable="false"
				android:persistent="false" />
		</PreferenceCategory>

		<PreferenceCategory android:title="@string/pref_post_launch_category">
			<ListPreference
				android:key="startupPostLaunchPolicy"
				android:title="@string/pref_post_launch_policy"
				android:entries="@array/post_launch_entries"
				android:entryValues="@array/post_launch_values"
				android:defaultValue="NONE" />

			<com.pijulius.xposedteyes.settings.IntPickerPreference
				android:key="startupRecoveryLimit"
				android:title="@string/pref_recovery_limit"
				android:defaultValue="1"
				xt:minValue="1"
				xt:maxValue="3"
				xt:scale="1"
				xt:presets="1,2,3"
				xt:unitLabel="@string/unit_times" />

			<com.pijulius.xposedteyes.settings.IntPickerPreference
				android:key="startupRecoveryDelayMs"
				android:title="@string/pref_recovery_delay"
				android:defaultValue="5000"
				xt:minValue="5"
				xt:maxValue="60"
				xt:scale="1000"
				xt:presets="5,10,30,60"
				xt:unitLabel="@string/unit_seconds" />
		</PreferenceCategory>

		<PreferenceCategory android:title="@string/pref_bt_category">
			<CheckBoxPreference
				android:key="btLaunchEnabled"
				android:title="@string/pref_bt_enabled"
				android:summary="@string/pref_bt_enabled_sum"
				android:defaultValue="false" />

			<com.pijulius.xposedteyes.settings.AppPickerPreference
				android:key="btLaunchTarget"
				android:title="@string/pref_bt_target" />

			<com.pijulius.xposedteyes.settings.IntPickerPreference
				android:key="btLaunchDelayMs"
				android:title="@string/pref_bt_delay"
				android:defaultValue="3000"
				xt:minValue="0"
				xt:maxValue="60"
				xt:scale="1000"
				xt:presets="0,3,5,10"
				xt:unitLabel="@string/unit_seconds" />

			<ListPreference
				android:key="btConflictPolicy"
				android:title="@string/pref_bt_conflict"
				android:summary="%s"
				android:entries="@array/bt_conflict_entries"
				android:entryValues="@array/bt_conflict_values"
				android:defaultValue="STARTUP_FIRST" />

			<CheckBoxPreference
				android:key="btLaunchOnDisconnect"
				android:title="@string/pref_bt_disconnect"
				android:summary="@string/pref_bt_disconnect_sum"
				android:defaultValue="false" />
		</PreferenceCategory>

		<PreferenceCategory android:title="@string/pref_accessibility_category">
			<Preference
				android:key="accessibilityStatus"
				android:title="@string/pref_accessibility_status"
				android:persistent="false" />

			<CheckBoxPreference
				android:key="rootAccessibilityAssist"
				android:title="@string/pref_root_assist"
				android:summary="@string/pref_root_assist_sum"
				android:defaultValue="false" />
		</PreferenceCategory>

		<PreferenceCategory android:title="@string/pref_startup_actions">
			<Preference
				android:key="startupLaunchNow"
				android:title="@string/pref_launch_now"
				android:summary="@string/pref_launch_now_sum"
				android:persistent="false" />

			<Preference
				android:key="startupLastResult"
				android:title="@string/pref_last_result"
				android:persistent="false" />

			<Preference
				android:key="startupRestoreDefaults"
				android:title="@string/pref_restore_startup"
				android:summary="@string/pref_restore_startup_sum"
				android:persistent="false" />
		</PreferenceCategory>
	</PreferenceScreen>

	<!-- ============================ CarPlay ============================ -->
	<PreferenceScreen
		android:key="screenCarplay"
		android:title="@string/pref_carplay_screen"
		android:summary="@string/pref_carplay_screen_sum">

		<Preference
			android:key="carplayStatus"
			android:title="@string/pref_feature_status"
			android:summary="@string/pref_carplay_status_sum"
			android:selectable="false"
			android:persistent="false" />

		<Preference
			android:key="carlinkInfo"
			android:title="@string/pref_carlink_info"
			android:summary="@string/pref_carlink_info_sum"
			android:persistent="false" />

		<PreferenceCategory android:title="@string/pref_controls_unavailable">
			<Preference
				android:title="@string/pref_carplay_density"
				android:summary="@string/status_not_confirmed"
				android:enabled="false"
				android:persistent="false" />
			<Preference
				android:title="@string/pref_carplay_scale"
				android:summary="@string/status_not_confirmed"
				android:enabled="false"
				android:persistent="false" />
			<Preference
				android:title="@string/pref_carplay_trial"
				android:summary="@string/status_not_confirmed"
				android:enabled="false"
				android:persistent="false" />
		</PreferenceCategory>
	</PreferenceScreen>

	<!-- ============================ BT call microphone ============================ -->
	<PreferenceScreen
		android:key="screenBtMic"
		android:title="@string/pref_btmic_screen"
		android:summary="@string/pref_btmic_screen_sum">

		<Preference
			android:key="btmicStatus"
			android:title="@string/pref_feature_status"
			android:summary="@string/pref_btmic_status_sum"
			android:selectable="false"
			android:persistent="false" />

		<Preference
			android:key="btmicDiagnostics"
			android:title="@string/pref_btmic_diag"
			android:summary="@string/pref_btmic_diag_sum"
			android:persistent="false" />

		<PreferenceCategory android:title="@string/pref_controls_unavailable">
			<Preference
				android:title="@string/pref_btmic_gain"
				android:summary="@string/status_not_confirmed"
				android:enabled="false"
				android:persistent="false" />
			<Preference
				android:title="@string/pref_btmic_agc"
				android:summary="@string/status_not_confirmed"
				android:enabled="false"
				android:persistent="false" />
			<Preference
				android:title="@string/pref_btmic_ns"
				android:summary="@string/status_not_confirmed"
				android:enabled="false"
				android:persistent="false" />
			<Preference
				android:title="@string/pref_btmic_aec"
				android:summary="@string/status_not_confirmed"
				android:enabled="false"
				android:persistent="false" />
		</PreferenceCategory>
	</PreferenceScreen>

	<!-- ============================ Advanced / diagnostics ============================ -->
	<PreferenceScreen
		android:key="screenAdvanced"
		android:title="@string/pref_advanced_screen"
		android:summary="@string/pref_advanced_screen_sum">

		<CheckBoxPreference
			android:key="newFeaturesDisabled"
			android:title="@string/pref_kill_switch"
			android:summary="@string/pref_kill_switch_sum"
			android:defaultValue="false" />

		<Preference
			android:key="compatibility"
			android:title="@string/pref_compatibility"
			android:summary="@string/pref_compatibility_sum"
			android:persistent="false" />

		<Preference
			android:key="localLog"
			android:title="@string/pref_local_log"
			android:summary="@string/pref_local_log_sum"
			android:persistent="false" />

		<Preference
			android:key="exportSettings"
			android:title="@string/pref_export"
			android:summary="@string/pref_export_sum"
			android:persistent="false" />

		<Preference
			android:key="importSettings"
			android:title="@string/pref_import"
			android:summary="@string/pref_import_sum"
			android:persistent="false" />

		<Preference
			android:key="restoreAllDefaults"
			android:title="@string/pref_restore_all"
			android:summary="@string/pref_restore_all_sum"
			android:persistent="false" />
	</PreferenceScreen>

	<!-- ============================ Existing features ============================ -->
	<PreferenceCategory
		android:title="@string/pref_teyes">

		<CheckBoxPreference 
			android:name="@string/pref_resizable_splitscreen"
			android:summary="@string/pref_resizable_splitscreen_sum"
			android:defaultValue="true"
			android:title="@string/pref_resizable_splitscreen"
			android:key="resizableSplitScreen" />

		<CheckBoxPreference 
			android:name="@string/pref_dont_exit_splitscreen"
			android:summary="@string/pref_dont_exit_splitscreen_sum"
			android:defaultValue="true"
			android:title="@string/pref_dont_exit_splitscreen"
			android:key="dontExitSplitScreen" />

		<EditTextPreference
			android:name="@string/pref_screen_ratio"
			android:summary="@string/pref_screen_ratio_sum"
			android:defaultValue="0.33"
			android:title="@string/pref_screen_ratio"
			android:key="screenRatio" />

		<CheckBoxPreference 
			android:disableDependentsState="true"
			android:name="@string/pref_hide_divider"
			android:summary="@string/pref_hide_divider_sum"
			android:defaultValue="false"
			android:title="@string/pref_hide_divider"
			android:key="hideDivider" />

		<EditTextPreference
			android:dependency="hideDivider"
			android:name="@string/pref_divider_width"
			android:summary="@string/pref_divider_width_sum"
			android:defaultValue="22"
			android:title="@string/pref_divider_width"
			android:key="dividerWidth" />

		<EditTextPreference
			android:dependency="hideDivider"
			android:name="@string/pref_divider_inset_position"
			android:summary="@string/pref_divider_inset_position_sum"
			android:defaultValue="10"
			android:title="@string/pref_divider_inset_position"
			android:key="dividerInsetPosition" />

		<CheckBoxPreference
			android:name="@string/pref_left_screen_position"
			android:summary="@string/pref_left_screen_position_sum"
			android:defaultValue="false"
			android:title="@string/pref_left_screen_position"
			android:key="leftScreenPosition" />

		<CheckBoxPreference
			android:name="@string/pref_force_systemui"
			android:summary="@string/pref_force_systemui_sum"
			android:defaultValue="false"
			android:title="@string/pref_force_systemui"
			android:key="forceSystemUI" />

		<CheckBoxPreference
			android:name="@string/pref_use_ad_blocking"
			android:summary="@string/pref_use_ad_blocking_sum"
			android:defaultValue="false"
			android:title="@string/pref_use_ad_blocking"
			android:key="useAdBlocking" />

	</PreferenceCategory>

	<PreferenceCategory
		android:title="@string/pref_camera">

		<EditTextPreference
			android:name="@string/pref_camera_width"
			android:summary="@string/pref_camera_width_sum"
			android:defaultValue="1570"
			android:title="@string/pref_camera_width"
			android:key="cameraWidth" />

		<EditTextPreference
			android:name="@string/pref_camera_height"
			android:summary="@string/pref_camera_height_sum"
			android:defaultValue="1070"
			android:title="@string/pref_camera_height"
			android:key="cameraHeight" />

		<EditTextPreference
			android:name="@string/pref_camera_x"
			android:summary="@string/pref_camera_x_sum"
			android:defaultValue="430"
			android:title="@string/pref_camera_x"
			android:key="cameraX" />

		<EditTextPreference
			android:name="@string/pref_camera_y"
			android:summary="@string/pref_camera_y_sum"
			android:defaultValue="0"
			android:title="@string/pref_camera_y"
			android:key="cameraY" />

		<CheckBoxPreference
			android:name="@string/pref_camera_warning"
			android:summary="@string/pref_camera_warning_sum"
			android:defaultValue="true"
			android:title="@string/pref_camera_warning"
			android:key="cameraWarning" />

		<CheckBoxPreference
			android:name="@string/pref_camera_enhance"
			android:summary="@string/pref_camera_enhance_sum"
			android:defaultValue="true"
			android:title="@string/pref_camera_enhance"
			android:key="cameraEnhance" />

		<CheckBoxPreference
			android:name="@string/pref_camera_round"
			android:summary="@string/pref_camera_round_sum"
			android:defaultValue="true"
			android:title="@string/pref_camera_round"
			android:key="cameraRound" />

		<CheckBoxPreference
			android:name="@string/pref_camera_keep_systemui"
			android:summary="@string/pref_camera_keep_systemui_sum"
			android:defaultValue="true"
			android:title="@string/pref_camera_keep_systemui"
			android:key="cameraKeepSystemUI" />

	</PreferenceCategory>

	<PreferenceCategory
		android:title="@string/pref_carlink">

		<ListPreference
			android:title="@string/pref_carlink_resolution"
			android:summary="@string/pref_carlink_resolution_sum"
			android:defaultValue=""
			android:entries="@array/pref_carlink_resolutions"
			android:entryValues="@array/pref_carlink_resolution_values"
			android:key="carlinkResolution" />

		<EditTextPreference
			android:name="@string/pref_carlink_resolution_width_margin"
			android:summary="@string/pref_carlink_resolution_width_margin_sum"
			android:defaultValue="0"
			android:title="@string/pref_carlink_resolution_width_margin"
			android:key="carlinkResolutionWidthMargin" />

		<EditTextPreference
			android:name="@string/pref_carlink_resolution_height_margin"
			android:summary="@string/pref_carlink_resolution_height_margin_sum"
			android:defaultValue="0"
			android:title="@string/pref_carlink_resolution_height_margin"
			android:key="carlinkResolutionHeightMargin" />

		<EditTextPreference
			android:name="@string/pref_carlink_dpi"
			android:summary="@string/pref_carlink_dpi_sum"
			android:defaultValue="0"
			android:title="@string/pref_carlink_dpi"
			android:key="carlinkDPI" />

		<CheckBoxPreference
			android:name="@string/pref_carlink_keep_systemui"
			android:summary="@string/pref_carlink_keep_systemui_sum"
			android:defaultValue="true"
			android:title="@string/pref_carlink_keep_systemui"
			android:key="carlinkKeepSystemUI" />

	</PreferenceCategory>

	<PreferenceCategory
		android:title="@string/pref_launcher">

		<com.pijulius.xposedteyes.settings.AppPickerPreference
			android:title="@string/pref_music_app"
			android:key="launcherMusicApp"
			xt:storePackageOnly="true" />

		<com.pijulius.xposedteyes.settings.AppPickerPreference
			android:title="@string/pref_navigation_app"
			android:key="launcherNavigationApp"
			xt:storePackageOnly="true" />

		<com.pijulius.xposedteyes.settings.AppPickerPreference
			android:title="@string/pref_videos_app"
			android:key="launcherVideosApp"
			xt:storePackageOnly="true" />

		<EditTextPreference
			android:name="@string/pref_mini_desktop_dpi"
			android:summary="@string/pref_mini_desktop_dpi_sum"
			android:defaultValue="500"
			android:title="@string/pref_mini_desktop_dpi"
			android:key="miniDesktopDPI" />

	</PreferenceCategory>

</PreferenceScreen>
