<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pijulius.xposedteyes"
    android:versionCode="30"
    android:versionName="3.0" >

    <!-- minSdk/targetSdk are set in build.gradle (28/28, unchanged). -->

    <!-- Guards the "settings changed" broadcast to SystemUI: only apps signed
         with the same key as this module can send it. -->
    <permission
        android:name="com.pijulius.xposedteyes.permission.CONTROL"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.pijulius.xposedteyes.permission.CONTROL" />

    <!-- Android 11+ package visibility: only launchable apps, for the app picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:theme="@style/AppTheme" >
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/app_description" />

        <activity
            android:name="com.pijulius.xposedteyes.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.pijulius.xposedteyes.LauncherActivity"
            android:theme="@android:style/Theme.NoDisplay">
        </activity>

        <activity
            android:name="com.pijulius.xposedteyes.MusicNavigationActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:label="@string/launcher_musicandnav"
            android:icon="@drawable/logo_musicnavigation"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts"
                 android:resource="@xml/shortcuts" /> 
        </activity>

        <activity
            android:name="com.pijulius.xposedteyes.NavigationVideosActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:label="@string/launcher_navandvideos"
            android:icon="@drawable/logo_navigationvideos"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts"
                 android:resource="@xml/shortcuts" /> 
        </activity>

        <activity
            android:name="com.pijulius.xposedteyes.AppPickerActivity"
            android:exported="false"
            android:label="@string/app_picker_title" />

        <!-- Started by SystemUI for split screen startup launches. Only
             holders of STATUS_BAR_SERVICE (SystemUI / platform apps) may start it. -->
        <activity
            android:name="com.pijulius.xposedteyes.SplitLaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="android.permission.STATUS_BAR_SERVICE"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Status reports from the SystemUI hook (startup app manager). -->
        <receiver
            android:name="com.pijulius.xposedteyes.StatusReceiver"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE">
            <intent-filter>
                <action android:name="com.pijulius.xposedteyes.STARTUP_STATUS" />
            </intent-filter>
        </receiver>

        <service
                android:name="com.pijulius.xposedteyes.LauncherService"
                android:exported="true"
                android:label="@string/app_name"
                android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/launcherservice" />
        </service>

    </application>

</manifest>