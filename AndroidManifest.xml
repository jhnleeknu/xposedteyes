<?xml version="1.0" encoding="utf-8"?>
<!-- package, versionCode/Name and SDK levels are set in app/build.gradle
     (namespace com.pijulius.xposedteyes, minSdk 28, targetSdk 28, unchanged). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets only this app (same signature) tell the SystemUI hook that settings changed. -->
    <permission
        android:name="com.pijulius.xposedteyes.permission.SETTINGS_SYNC"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.pijulius.xposedteyes.permission.SETTINGS_SYNC" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:theme="@style/AppTheme" >
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/app_description" />

        <activity
            android:name="com.pijulius.xposedteyes.SettingsActivity"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.pijulius.xposedteyes.LauncherActivity"
            android:theme="@android:style/Theme.NoDisplay">
        </activity>

        <activity
            android:name="com.pijulius.xposedteyes.MusicNavigationActivity"
            android:theme="@android:style/Theme.NoDisplay"
            android:label="@string/launcher_musicandnav"
            android:icon="@drawable/logo_musicnavigation"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts"
                 android:resource="@xml/shortcuts" /> 
        </activity>

        <activity
            android:name="com.pijulius.xposedteyes.NavigationVideosActivity"
            android:theme="@android:style/Theme.NoDisplay"
            android:label="@string/launcher_navandvideos"
            android:icon="@drawable/logo_navigationvideos"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts"
                 android:resource="@xml/shortcuts" /> 
        </activity>

        <!-- Started by the SystemUI hook. Exported but input free: it only ever launches
             the split screen pair selected in the settings. -->
        <activity
            android:name="com.pijulius.xposedteyes.StartupSplitActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name="com.pijulius.xposedteyes.settings.AppPickerActivity"
            android:exported="false"
            android:label="@string/app_picker_title" />

        <activity
            android:name="com.pijulius.xposedteyes.diag.DiagnosticsActivity"
            android:exported="false"
            android:label="@string/pref_advanced_screen" />

        <!-- Launch status from SystemUI. STATUS_BAR_SERVICE is held by SystemUI and cannot be
             obtained by ordinary apps, so other apps cannot feed this receiver. -->
        <receiver
            android:name="com.pijulius.xposedteyes.diag.StatusReceiver"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE">
            <intent-filter>
                <action android:name="com.pijulius.xposedteyes.action.LAUNCH_STATUS" />
            </intent-filter>
        </receiver>

        <service
                android:name="com.pijulius.xposedteyes.LauncherService"
                android:label="@string/app_name"
                android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/launcherservice" />
        </service>

    </application>

</manifest>